# gadget plan generated by gadget_plan.py from kitchen.toml
# options: name=device max_speed=as-described test_ids=no console=yes dev=yes
# note: device class set to 0xEF/02/01 (required for the kernel's acm/ncm/rndis/uac2 interface association)
# note: device_to_host: the kernel refuses volume 0..100 step 3 (needs max > min, in whole steps)
name device
write idVendor 0x1209
write idProduct 0x0001
write bcdDevice 0x0203
write bcdUSB 0x0200
write bDeviceClass 0x00ef
write bDeviceSubClass 0x0002
write bDeviceProtocol 0x0001
write bMaxPacketSize0 64
write max_speed high-speed
mkdir strings/0x409
write strings/0x409/manufacturer usb
write strings/0x409/product Kitchen Sink
write strings/0x409/serialnumber K-0001
write hide_strings 4
mkdir strings/0x409/s4
write strings/0x409/s4/s Spare
mkdir strings/0x409/s5
write strings/0x409/s5/s
mkdir configs/c.1
write configs/c.1/bmAttributes 0x00c0
write configs/c.1/MaxPower 100
mkdir functions/uac2.audio
write? functions/uac2.audio/function_name Kitchen Audio
write? functions/uac2.audio/if_ctrl_name Audio Control
write functions/uac2.audio/fb_max 5
write functions/uac2.audio/req_number 4
write functions/uac2.audio/c_chmask 51
write functions/uac2.audio/c_ssize 3
write functions/uac2.audio/c_srate 44100,48000,96000
write? functions/uac2.audio/c_sync adaptive
write? functions/uac2.audio/c_hs_bint 1
write? functions/uac2.audio/clksrc_out_name Clock Out
write functions/uac2.audio/c_mute_present 1
write functions/uac2.audio/c_volume_present 1
write functions/uac2.audio/c_volume_min -12800
write functions/uac2.audio/c_volume_max 0
write functions/uac2.audio/c_volume_res 256
write functions/uac2.audio/p_terminal_type 770
write? functions/uac2.audio/c_ot_name Headphones
write? functions/uac2.audio/c_it_name Host Out
write? functions/uac2.audio/c_fu_vol_name Volume
write? functions/uac2.audio/c_it_ch_name Stereo
write functions/uac2.audio/p_chmask 1
write functions/uac2.audio/p_ssize 2
write functions/uac2.audio/p_srate 48000
write functions/uac2.audio/p_mute_present 0
write functions/uac2.audio/p_volume_present 1
write functions/uac2.audio/p_volume_min 0
write functions/uac2.audio/p_volume_max 100
write functions/uac2.audio/p_volume_res 3
write functions/uac2.audio/c_terminal_type 513
write? functions/uac2.audio/p_it_name Mic
link functions/uac2.audio configs/c.1/uac2.audio
mkdir functions/ncm.net
write functions/ncm.net/dev_addr 02:00:00:00:00:01
write functions/ncm.net/qmult 10
write functions/ncm.net/ifname kit%d
write functions/ncm.net/max_segment_size 1514
link functions/ncm.net configs/c.1/ncm.net
mkdir functions/rndis.0
link functions/rndis.0 configs/c.1/rndis.0
mkdir functions/hid.keys
write functions/hid.keys/protocol 1
write functions/hid.keys/subclass 1
write functions/hid.keys/report_length 8
hex functions/hid.keys/report_desc 05010906a101c0
write functions/hid.keys/name
write? functions/hid.keys/no_out_endpoint 1
write? functions/hid.keys/interval 4
link functions/hid.keys configs/c.1/hid.keys
mkdir functions/acm.console
link functions/acm.console configs/c.1/acm.console
console functions/acm.console
