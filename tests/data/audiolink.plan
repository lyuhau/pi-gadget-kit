# gadget plan generated by gadget_plan.py from audiolink.toml
# options: name=device max_speed=as-described test_ids=no console=yes dev=yes
# note: device class set to 0xEF/02/01 (required for the kernel's acm/ecm/uac2 interface association)
name device
write idVendor 0x1d6b
write idProduct 0x0104
write bcdDevice 0x0100
write bcdUSB 0x0200
write bDeviceClass 0x00ef
write bDeviceSubClass 0x0002
write bDeviceProtocol 0x0001
write bMaxPacketSize0 64
write max_speed high-speed
mkdir strings/0x409
write strings/0x409/manufacturer audiolink
write strings/0x409/product AudioPi
write strings/0x409/serialnumber audiopi0001
write hide_strings 0
mkdir configs/c.1
write configs/c.1/bmAttributes 0x0080
write configs/c.1/MaxPower 250
mkdir configs/c.1/strings/0x409
write configs/c.1/strings/0x409/configuration AudioPi
mkdir functions/ecm.net
write functions/ecm.net/dev_addr 02:a0:00:00:00:01
write functions/ecm.net/host_addr 02:a0:00:00:00:02
link functions/ecm.net configs/c.1/ecm.net
mkdir functions/uac2.audio
write? functions/uac2.audio/function_name AudioPi
write functions/uac2.audio/c_chmask 3
write functions/uac2.audio/c_ssize 2
write functions/uac2.audio/c_srate 48000
write functions/uac2.audio/c_mute_present 0
write functions/uac2.audio/c_volume_present 0
write functions/uac2.audio/p_chmask 3
write functions/uac2.audio/p_ssize 2
write functions/uac2.audio/p_srate 48000
write functions/uac2.audio/p_mute_present 0
write functions/uac2.audio/p_volume_present 0
link functions/uac2.audio configs/c.1/uac2.audio
mkdir functions/acm.console
link functions/acm.console configs/c.1/acm.console
console functions/acm.console
