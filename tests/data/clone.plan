# gadget plan generated by gadget_plan.py from clone.toml
# options: name=device max_speed=as-described test_ids=no console=yes dev=yes extras=no
# note: extras = false: no debug console or dev functions
# note: net: a dev function, left out (--dev / [device] dev_functions)
name device
write idVendor 0x1209
write idProduct 0x0003
write bcdDevice 0x0100
write bcdUSB 0x0200
write bDeviceClass 0x0000
write bDeviceSubClass 0x0000
write bDeviceProtocol 0x0000
write bMaxPacketSize0 64
write max_speed high-speed
mkdir strings/0x409
write strings/0x409/manufacturer usb example
write strings/0x409/product clone
write hide_strings 0
mkdir configs/c.1
write configs/c.1/bmAttributes 0x0080
write configs/c.1/MaxPower 100
mkdir functions/uac1.audio
write functions/uac1.audio/function_name Clone Audio
write functions/uac1.audio/int_ep_present 0
write functions/uac1.audio/c_chmask 3
write functions/uac1.audio/c_ssize 2
write functions/uac1.audio/c_srate 48000
write functions/uac1.audio/c_mute_present 0
write functions/uac1.audio/c_volume_present 0
write functions/uac1.audio/c_ot_name
write functions/uac1.audio/c_it_name
write functions/uac1.audio/c_fu_vol_name
write functions/uac1.audio/c_it_ch_name
write functions/uac1.audio/c_alt0_name
write functions/uac1.audio/c_alt1_name
write functions/uac1.audio/p_chmask 0
link functions/uac1.audio configs/c.1/uac1.audio
