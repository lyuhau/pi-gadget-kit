#!/bin/sh
# USB serial gadget with a root shell, for when Wi-Fi/SSH don't come up. The
# Mac sees /dev/cu.usbmodem*. gadget.sh unbinds it to take over the port (a
# device with [device] console has its own). Only with the card's setting
# console = on (default: [access] debug_console).
G=/sys/kernel/config/usb_gadget/console
SETTING_CONSOLE=on
[ -f /etc/usb-gadget/settings.defaults ] && . /etc/usb-gadget/settings.defaults
[ -f /run/usb-gadget/settings.env ] && . /run/usb-gadget/settings.env
[ "$SETTING_CONSOLE" = off ] && exit 0
modprobe libcomposite
mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
[ -d $G ] && exit 0
mkdir -p $G/strings/0x409 $G/configs/c.1 $G/functions/acm.0
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
cat /etc/hostname > $G/strings/0x409/manufacturer
echo "debug console" > $G/strings/0x409/product
ln -s $G/functions/acm.0 $G/configs/c.1/
ls /sys/class/udc | head -n 1 > $G/UDC
sh /etc/usb-gadget/console.sh start ttyGS$(cat $G/functions/acm.0/port_num)
