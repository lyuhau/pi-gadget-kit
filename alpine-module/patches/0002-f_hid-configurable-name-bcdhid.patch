+static ssize_t f_hid_opts_name_show(struct config_item *item, char *page)
+{
+	struct f_hid_opts *opts = to_f_hid_opts(item);
+	int result;
+
+	mutex_lock(&opts->lock);
+	result = sysfs_emit(page, "%s\n", opts->name);
+	mutex_unlock(&opts->lock);
+
+	return result;
+}
+
+static ssize_t f_hid_opts_name_store(struct config_item *item,
+				     const char *page, size_t len)
+{
+	struct f_hid_opts *opts = to_f_hid_opts(item);
+	int ret;
+
+	mutex_lock(&opts->lock);
+	if (opts->refcnt) {
+		ret = -EBUSY;
+		goto end;
+	}
+	/* whole write minus a trailing newline; "\n" alone clears it */
+	ret = scnprintf(opts->name, min(sizeof(opts->name), len + 1), "%s", page);
+	if (ret && opts->name[ret - 1] == '\n')
+		opts->name[ret - 1] = '\0';
+	ret = len;
+end:
+	mutex_unlock(&opts->lock);
+	return ret;
+}
+
+CONFIGFS_ATTR(f_hid_opts_, name);
