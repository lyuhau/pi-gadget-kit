+/*
+ * Like usb_ep_autoconfig(), but if num is nonzero claim that endpoint number,
+ * so the endpoint layout can match a captured device.
+ */
+static struct usb_ep *uac1_ep_claim(struct usb_gadget *gadget,
+				    struct usb_endpoint_descriptor *desc, u32 num)
+{
+	struct usb_ep *ep;
+
+	if (!num)
+		return usb_ep_autoconfig(gadget, desc);
+
+	list_for_each_entry(ep, &gadget->ep_list, ep_list) {
+		if (!isdigit(ep->name[2]) ||
+		    simple_strtoul(&ep->name[2], NULL, 10) != num)
+			continue;
+		if (!usb_gadget_ep_match_desc(gadget, ep, desc, NULL))
+			continue;
+		desc->bEndpointAddress = (desc->bEndpointAddress & USB_DIR_IN) | num;
+		ep->address = desc->bEndpointAddress;
+		ep->desc = NULL;
+		ep->comp_desc = NULL;
+		ep->claimed = true;
+		return ep;
+	}
+	return NULL;
+}
