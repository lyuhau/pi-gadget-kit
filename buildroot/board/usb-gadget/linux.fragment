# USB device mode with configfs gadget functions; functions stay modules so a
# patched usb_f_uac1.ko can be swapped in without rebuilding the kernel.
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=m
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_USB_CONFIGFS_F_UAC2=y
CONFIG_USB_CONFIGFS_F_HID=y
# userspace-driven gadget: replay captured descriptors byte for byte
CONFIG_USB_RAW_GADGET=m
